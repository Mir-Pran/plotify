# ===========================================================
#  Plotify Bangladesh — Environment Variables
#  Copy this file to .env.local and fill in your values
# ===========================================================

# --- Supabase (required for auth, database, storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Gemini AI (required for Panda AI chatbot) ---
# Get your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WA_NUMBER=+8809612000888

# --- Email Service / Nodemailer (Password Reset) ---
# For Gmail: Set your address and 16-character App Password (https://myaccount.google.com/apppasswords)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
# Optional Custom SMTP (uncomment if using custom SMTP / domain mail instead of Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM="Plotify" <your-email@gmail.com>

